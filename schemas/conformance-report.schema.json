{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:substratex:evidence-commons:1.0:schema:conformance-report",
  "title": "ECS Conformance Report",
  "type": "object",
  "required": [
    "ecs_version",
    "report_id",
    "implementation",
    "profiles",
    "corpus_version",
    "results",
    "environment",
    "created_at"
  ],
  "properties": {
    "ecs_version": {
      "const": "1.0"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "implementation": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "corpus_version": {
      "type": "string",
      "minLength": 1
    },
    "results": {
      "type": "object",
      "required": [
        "passed",
        "failed",
        "skipped"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "integrity": {
      "anyOf": [
        {
          "$ref": "urn:substratex:evidence-commons:1.0:schema:common-defs#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
